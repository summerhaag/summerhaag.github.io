---
// Top menu shown on every page. `current` highlights the page you're on.
import { getPaperGroups } from '../lib/content';

interface Props { current?: string }
const { current } = Astro.props;
const paperGroups = await getPaperGroups();

const links = [
	{ id: 'talks',    href: '/talks',    label: 'Talks' },
	{ id: 'teaching', href: '/teaching', label: 'Teaching' },
	{ id: 'gallery',  href: '/gallery',  label: 'Gallery' },
];
---

<nav>
	<div class="nav-inner">
		<a href="/" class="nav-logo">Summer Haag</a>
		<ul class="nav-links">
			<li><a href="/#about">About</a></li>
			<li class="nav-dropdown">
				<a href="/research" aria-haspopup="true" aria-current={current === 'research' ? 'page' : undefined}>
					Research <span class="nav-caret" aria-hidden="true">▾</span>
				</a>
				<ul class="nav-submenu">
					{paperGroups.map((group) => (
						<li><a href={`/research#${group.id}`}>{group.heading}</a></li>
					))}
				</ul>
			</li>
			{links.map((link) => (
				<li><a href={link.href} aria-current={current === link.id ? 'page' : undefined}>{link.label}</a></li>
			))}
		</ul>
	</div>
</nav>

---
import Layout from '../layouts/Layout.astro';
import PaperList from '../components/PaperList.astro';
import TalkList from '../components/TalkList.astro';
import GallerySectionCards from '../components/GallerySectionCards.astro';
import { getPaperGroups, getTalks, getGallerySections, getFeaturedDemos } from '../lib/content';

// Home page: About plus short previews that link to the full pages
const paperGroups = await getPaperGroups();
const published = paperGroups.find((g) => g.id === 'published');
const otherGroups = paperGroups.filter((g) => g.id !== 'published');
const recentTalks = (await getTalks()).slice(0, 2);
// Interactive demo card(s) first, then section cards, 3 cards total
const featuredDemos = (await getFeaturedDemos()).slice(0, 1);
const galleryPreview = (await getGallerySections()).slice(0, 3 - featuredDemos.length);
---

<Layout title="Summer Haag">

	<!-- Hero -->
	<section id="top" class="hero">
		<div class="hero-content">
			<p class="hero-label">Welcome</p>
			<h1>Summer Haag</h1>
			<p class="hero-subtitle">PhD Student in Mathematics &middot; University of Colorado Boulder</p>
			<div class="hero-actions">
				<a href="#about" class="btn-primary">About Me</a>
				<a href="/research" class="btn-secondary">My Research</a>
			</div>
		</div>
		<div class="hero-decoration">
			<div class="blob blob-1"></div>
			<div class="blob blob-2"></div>
			<div class="blob blob-3"></div>
		</div>
	</section>

	<!-- About -->
	<section id="about" class="section section-about">
		<div class="container">
			<div class="section-tag">About Me</div>
			<h2>Summer Haag</h2>
			<div class="section-body two-col">
				<div class="text-block">
					<p>
						I am currently a fifth year mathematics PhD student at the University of Colorado Boulder. 
						I enjoy questions that are simple to explain but have complex solutions and explorations, especially 
						focusing on the visual explorations. 
						I'm interested in number theory, specifically Apollonian circle packings, Kleinian groups, continued
						fractions, and quadratic forms. 
						These topics relate to many areas like hyperbolic geometry, arithmetic groups, and lattices.
						My advisor is <a href="https://math.katestange.net/" target="_blank" rel="noopener noreferrer">Katherine E. Stange</a>.
					</p>
					<p>
						B.A. in Mathematics, University of Georgia, May 2022.
					</p>
					<dl class="about-details">
						<div><dt>Institution</dt><dd>University of Colorado Boulder</dd></div>
						<div><dt>Department</dt><dd>Department of Mathematics</dd></div>
						<div><dt>Office</dt><dd>MATH 340</dd></div>
						<div><dt>Email</dt><dd>summer.haag@colorado.edu</dd></div>
					</dl>
					<div class="contact-links">
						<a href="mailto:summer.haag@colorado.edu" class="contact-chip">Email</a>
						<a href="/cv.pdf" target="_blank" class="contact-chip">CV</a>
						<a href="/SummerHaag_resume 1.25_copy.pdf" target="_blank" class="contact-chip">Resume</a>
					</div>
				</div>
				<div class="photo-block">
					<img src="/profile.jpeg" alt="Summer Haag" class="profile-photo" />
				</div>
			</div>
		</div>
	</section>

	<!-- Research preview -->
	<section id="research" class="section section-research">
		<div class="container">
			<div class="section-tag">Research</div>
			<h2>My Work</h2>
			<p class="section-intro">
				I am interested in algebraic number theory, focusing on illustrating mathematics,
				computations, and connecting topics to get different perspectives.
				My current research is focused on Apollonian circle packings.
			</p>
			{published && (
				<div class="research-subsection">
					<h3 class="subsection-heading">Recent Papers</h3>
					<PaperList group={published} limit={2} />
				</div>
			)}
			<div class="preview-footer">
				<a href="/research" class="see-all">All research →</a>
				{otherGroups.map((g) => (
					<a href={`/research#${g.id}`} class="see-all-secondary">{g.heading} ({g.items.length})</a>
				))}
			</div>
		</div>
	</section>

	<!-- Talks preview -->
	<section id="talks" class="section section-talks">
		<div class="container">
			<div class="section-tag">Presentations</div>
			<h2>Recent Talks</h2>
			<TalkList talks={recentTalks} />
			<div class="preview-footer">
				<a href="/talks" class="see-all">All talks →</a>
			</div>
		</div>
	</section>

	<!-- Gallery preview -->
	<section id="gallery" class="section section-gallery section-white">
		<div class="container">
			<div class="section-tag">Art &amp; Code</div>
			<h2>Gallery</h2>
			<p class="section-intro">Illustrations of circle packings and interactive shader demos.</p>
			{galleryPreview.length > 0 && <GallerySectionCards sections={galleryPreview} demos={featuredDemos} />}
			<div class="preview-footer">
				<a href="/gallery" class="see-all">Visit the gallery →</a>
				<a href="/demos/parameter-space" class="see-all-secondary">Interactive parameter space</a>
				<a href="https://github.com/summerhaag" target="_blank" rel="noopener noreferrer" class="see-all-secondary">My code on GitHub</a>
			</div>
		</div>
	</section>

</Layout>

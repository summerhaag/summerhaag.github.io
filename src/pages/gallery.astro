---
import Layout from '../layouts/Layout.astro';
import GallerySectionCards from '../components/GallerySectionCards.astro';
import DemoGrid from '../components/DemoGrid.astro';
import ShaderCredit from '../components/ShaderCredit.astro';
import { getGallerySections, getFeaturedDemos } from '../lib/content';

const gallerySections = await getGallerySections();
const featuredDemos = await getFeaturedDemos();
---

<Layout title="Gallery — Summer Haag" current="gallery">
	<section class="section section-gallery page-top">
		<div class="container">
			<div class="section-tag">Art &amp; Code</div>
			<h2>Gallery</h2>
			<p class="gallery-note">
				Some of these images were made with the help of AI tools, and some were created by
				others or with code written by others.
			</p>
			<p class="code-link">
				<a href="https://github.com/summerhaag" target="_blank" rel="noopener noreferrer" class="see-all">My code on GitHub →</a>
			</p>

			<GallerySectionCards sections={gallerySections} demos={featuredDemos} />

			<div class="gallery-subsection" id="interactive-code">
				<h3 class="subsection-heading">Interactive Code</h3>
				<ShaderCredit />
				<DemoGrid />
			</div>
		</div>
	</section>
</Layout>

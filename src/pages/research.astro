---
import Layout from '../layouts/Layout.astro';
import PaperList from '../components/PaperList.astro';
import { getPaperGroups } from '../lib/content';

const paperGroups = await getPaperGroups();
---

<Layout title="Research — Summer Haag" current="research">
	<section class="section section-research page-top">
		<div class="container">
			<div class="section-tag">Research</div>
			<h2>My Work</h2>
			<p class="section-intro">
				I am interested in algebraic number theory, focusing on illustrating mathematics,
				computations, and connecting topics to get different perspectives.
				My current research is focused on Apollonian circle packings.
			</p>

			<ul class="jump-links">
				{paperGroups.map((group) => (
					<li><a href={`#${group.id}`}>{group.heading} <span class="jump-count">{group.items.length}</span></a></li>
				))}
			</ul>

			{paperGroups.map((group) => (
				<div class="research-subsection" id={group.id}>
					<h3 class="subsection-heading">{group.heading}</h3>
					<PaperList group={group} />
				</div>
			))}
		</div>
	</section>
</Layout>
